{
  "manifest_version": 3,
  "name": "Finance Terminal & Ticker HUD Pro",
  "version": "2.0",
  "description": "Professional real-time Finance Terminal & Ticker HUD: multi-asset live tracking, continuous rolling ticker tape, zero-scroll technical charting, smart toolbar badge, USD portfolio tracker, and audio alerts.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.binance.com/*",
    "https://api.coingecko.com/*",
    "https://query1.finance.yahoo.com/*"
  ],
  "icons": {
    "16": "icons/finance-hud.svg",
    "32": "icons/finance-hud.svg",
    "48": "icons/finance-hud.svg",
    "128": "icons/finance-hud.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/finance-hud.svg",
      "32": "icons/finance-hud.svg"
    }
  }
}
