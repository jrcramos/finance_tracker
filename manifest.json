{
  "manifest_version": 3,
  "name": "Finance Tracker & Ticker HUD",
  "version": "1.0",
  "description": "Real-time Gold (XAU/USD), Crypto (BTC/ETH), and Forex/DXY tracker with live toolbar badge, price alerts, and mini sparkline charts.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.binance.com/*",
    "https://api.coingecko.com/*",
    "https://query1.finance.yahoo.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
